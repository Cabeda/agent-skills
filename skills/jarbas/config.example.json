  "task_rules": [
    { "regex": "^close work$", "kind": "fixed" }
  ],
  "focus_title_regex": "(\\bfocus\\b|deep[ -]?work)",
  "mirror_calendars": ["todoist"],
  "overlays": [],
  "extensions": []
}
